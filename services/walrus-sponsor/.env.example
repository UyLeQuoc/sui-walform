# WalForm Walrus file sponsor — env. Set these in Railway → Variables.

# Sui private key (suiprivkey1...) of the platform wallet, funded with WAL + SUI
# on each network you sponsor. Generate with:
#   deno eval "import {Ed25519Keypair} from 'npm:@mysten/sui@2.20.3/keypairs/ed25519'; const k=new Ed25519Keypair(); console.log('address:',k.toSuiAddress()); console.log('secret :',k.getSecretKey())"
WALRUS_SPONSOR_KEY=

# Comma-separated origins allowed to call this service. Unset or "*" = any.
ALLOWED_ORIGIN=https://walform.wal.app,http://localhost:3000

# Per-request byte cap. Default 100 MiB. Size the Railway instance RAM to ~ this
# × 6-8 (Walrus encoding expansion) + overhead — e.g. ~2 GB for 100 MiB.
SPONSOR_MAX_BYTES=104857600

# Storage duration (epochs), relay tip ceiling (MIST), per-wallet daily quotas.
SPONSOR_EPOCHS=15
SPONSOR_TIP_MAX_MIST=100000000
SPONSOR_DAILY_BYTES=524288000
SPONSOR_DAILY_COUNT=50

# PORT is injected by Railway; defaults to 8787 locally.
