    "@tanstack/react-query": "^5.100.1",
    "@walform/core": "workspace:*",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@walform/eslint-config": "workspace:*",
    "@walform/prettier-config": "workspace:*",
    "@walform/tsconfig": "workspace:*",
    "eslint": "^9",
    "prettier": "latest",
