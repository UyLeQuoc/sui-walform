{
  "name": "@walform/walform-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3002",
    "build": "vite build && bun run scripts/mirror-bundle.ts",
    "start": "vite preview --port 3002",
    "preview": "vite preview --port 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "bundle:mirror": "bun run scripts/mirror-bundle.ts",
    "walrus:publish-site": "bun run scripts/publish-to-walrus.ts"
  },
  "dependencies": {
    "@mysten/dapp-kit": "latest",
    "@mysten/enoki": "latest",
    "@mysten/seal": "latest",
    "@mysten/sui": "latest",
    "@mysten/walrus": "latest",
    "@tanstack/react-query": "^5.100.10",
    "@walform/core": "workspace:*",
    "react": "19.2.6",
    "react-router-dom": "^7",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@walform/eslint-config": "workspace:*",
    "@walform/prettier-config": "workspace:*",
    "@walform/tsconfig": "workspace:*",
    "eslint": "^10",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6",
    "vite": "^7"
  }
}
