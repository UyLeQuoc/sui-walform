# ── Sui (testnet object ids live in apps/contracts/deployed.json) ──
# After `bun run contracts:publish` (first deploy) OR `bun run contracts:upgrade`:
#   NEXT_PUBLIC_PACKAGE_ID            = deployed.json :: packageId          (BUMPS on every upgrade — used as MoveCall target)
#   NEXT_PUBLIC_ORIGINAL_PACKAGE_ID   = deployed.json :: originalPackageId  (STABLE — used as the Seal identity namespace in seal.encrypt)
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_WALRUS_NETWORK=testnet
# Walrus uploads (cover images + FILE_UPLOAD attachments) use the @mysten/walrus
# SDK server-side at apps/builder/app/api/walrus/upload. WAL storage is paid by
# the operator keypair (WALRUS_ADMIN_SECRET_KEY) so creators/respondents don't
# need to hold WAL. Aggregator URL below is used for the GET side (rendering
# uploaded blobs); override if you run your own aggregator.
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
# Walrus Sites Move package id on testnet — the type prefix used by
# `site::new_site` / `add_resource` and the portal's resource resolver.
# The canonical Mysten testnet deployment as of 2026-04 is below; if Mysten
# rotates, look it up via `sui_getNormalizedMoveModule` or the upstream
# `sites-config.yaml` in MystenLabs/walrus-sites.
NEXT_PUBLIC_WALRUS_SITE_PACKAGE_ID=0x22b8c1496650eb45fbcca0f8f37fae77ed33b7d4eaab4da5f0bb9b62a8708dcb
NEXT_PUBLIC_PACKAGE_ID=
NEXT_PUBLIC_ORIGINAL_PACKAGE_ID=
NEXT_PUBLIC_PACKAGE_ID_MAINNET=
NEXT_PUBLIC_PORTAL_DOMAIN=

# ── Enoki (zkLogin sign-in only — no server-side signing) ──
NEXT_PUBLIC_ENOKI_PUBLIC_KEY=                 # public Enoki key — registerEnokiWallets
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                 # Google OAuth client ID registered in Enoki
# OAuth redirect URL — MUST exactly match an "Authorized redirect URIs" entry
# in the Google Cloud Console. We pin to origin root so only ONE url needs to
# be whitelisted regardless of which page initiates login. For prod set this
# to your production origin with a trailing slash (e.g. https://walform.app/).
NEXT_PUBLIC_ENOKI_REDIRECT_URL=http://localhost:3000/

# ── Seal ──
# Default: 1 decentralized testnet committee server + Mysten's hosted aggregator
# (threshold=1 at the SDK layer; the committee handles 2-of-N MPC internally).
# Reference: https://seal-docs.wal.app (testnet committee objectId is advertised there).
# Swap to 3 discrete single-node servers by listing 3 objectIds (comma-separated) and bumping threshold to 2.
NEXT_PUBLIC_SEAL_KEY_SERVERS=                 # comma-separated key server objectIds; blank = default testnet committee
NEXT_PUBLIC_SEAL_AGGREGATOR_URL=              # only used in committee mode; applied to every server entry
NEXT_PUBLIC_SEAL_THRESHOLD=1
# Turn on only AFTER `seal_policies.move` v2 is upgraded on the deployed package
# (adds `seal_approve_read_form_schema`).
NEXT_PUBLIC_ENABLE_SEALED_SCHEMA=false

# ── Walrus admin (server-side WAL payer for /api/walrus/upload) ──
# Sui bech32 suiprivkey... that holds WAL on the configured network.
# Used ONLY for Walrus storage payment — never signs Sui transactions on
# behalf of users. Every Sui tx in WalForm is signed and paid by the user's
# connected wallet.
WALRUS_ADMIN_SECRET_KEY=
