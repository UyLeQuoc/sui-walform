# ── Default network ───────────────────────────────────────────────────────────
# UI lets users switch testnet ↔ mainnet via the wallet dropdown. This is just
# the seed used when localStorage `walform:network` is empty (fresh visitor).
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# ── Sui RPC transport (per-network) ───────────────────────────────────────────
# JSON-RPC is GONE — testnet's public endpoint already answers 404 and mainnet's
# switches off 2026-07-31. The app reads chain state two ways instead:
#
#   gRPC     — objects, balances, coins, transactions, execution.
#   GraphQL  — events + transaction-history scans. gRPC has NEITHER (verified
#              by reflection against a live node), so this is mandatory.
#
# gRPC: unset → official fullnode (`https://fullnode.<net>.sui.io`), which is
# current, unpruned, and CORS-open, so gRPC-web works from the browser with no
# key. Override only for a higher rate limit.
NEXT_PUBLIC_SUI_GRPC_TESTNET=
NEXT_PUBLIC_SUI_GRPC_MAINNET=
#
# GraphQL: ⚠️ MUST be a FULL-HISTORY indexer. Every scan here enumerates from
# genesis, and the official GraphQL prunes to a rolling window — measured
# 2026-07-28 on mainnet it served 155 of 247 SubmissionCreated events and 7 of
# 34 AllowlistCreated. On a pruning endpoint, old responses and paid listings
# silently disappear. Unset falls back to the official (pruning) endpoint.
# Any key here ships in the public JS bundle — restrict it by origin in the
# provider's dashboard.
NEXT_PUBLIC_SUI_GRAPHQL_TESTNET=
NEXT_PUBLIC_SUI_GRAPHQL_MAINNET=

# ── Sui core ids (per-network) ────────────────────────────────────────────────
# After `bun run contracts:publish` (first deploy) OR `bun run contracts:upgrade`,
# mirror packageId / originalPackageId from apps/contracts/deployed.{testnet,mainnet}.json
# into the matching variant. Both networks can be filled — hooks pick the
# active one based on `useSuiClientContext().network`.
#
#   NEXT_PUBLIC_PACKAGE_ID_*            = deployed.json :: packageId          (BUMPS on every upgrade — MoveCall target)
#   NEXT_PUBLIC_ORIGINAL_PACKAGE_ID_*   = deployed.json :: originalPackageId  (STABLE — Seal identity namespace)
NEXT_PUBLIC_PACKAGE_ID_TESTNET=
NEXT_PUBLIC_ORIGINAL_PACKAGE_ID_TESTNET=
NEXT_PUBLIC_TRANSFER_POLICY_ID_TESTNET=
NEXT_PUBLIC_PLATFORM_TREASURY_ID_TESTNET=
NEXT_PUBLIC_PUBLIC_SUBMIT_ALLOWLIST_ID_TESTNET=

NEXT_PUBLIC_PACKAGE_ID_MAINNET=
NEXT_PUBLIC_ORIGINAL_PACKAGE_ID_MAINNET=
NEXT_PUBLIC_TRANSFER_POLICY_ID_MAINNET=
NEXT_PUBLIC_PLATFORM_TREASURY_ID_MAINNET=
NEXT_PUBLIC_PUBLIC_SUBMIT_ALLOWLIST_ID_MAINNET=

# ── Walrus (per-network) ──────────────────────────────────────────────────────
# Aggregator = GET host for blobs. Upload relay = client push relay during
# writeBlob registration. Site packageId = Walrus Sites Move package on this
# network. Portal host = optional override for self-hosted portals on
# non-mainnet (mainnet always resolves at wal.app).
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL_TESTNET=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_SITE_PACKAGE_ID_TESTNET=0x22b8c1496650eb45fbcca0f8f37fae77ed33b7d4eaab4da5f0bb9b62a8708dcb
NEXT_PUBLIC_WALRUS_UPLOAD_RELAY_HOST_TESTNET=https://upload-relay.testnet.walrus.space
NEXT_PUBLIC_WALRUS_PORTAL_HOST_TESTNET=localhost:4000

NEXT_PUBLIC_WALRUS_AGGREGATOR_URL_MAINNET=
NEXT_PUBLIC_WALRUS_SITE_PACKAGE_ID_MAINNET=
NEXT_PUBLIC_WALRUS_UPLOAD_RELAY_HOST_MAINNET=
NEXT_PUBLIC_WALRUS_PORTAL_HOST_MAINNET=

# ── Walrus file sponsor (optional) ────────────────────────────────────────────
# When set, submission file uploads within the size cap are routed through the
# platform sponsor (Supabase Edge Function `walrus-file-sponsor`) so the PLATFORM
# pays WAL — respondents never touch WAL. Unset → every upload is wallet-paid
# (current behaviour). Same endpoint for both networks (client passes `network`).
# Max bytes must stay <= the function's SPONSOR_MAX_BYTES; above it the client
# falls back to wallet-paid. Default cap 25 MiB.
NEXT_PUBLIC_WALRUS_SPONSOR_URL=
NEXT_PUBLIC_WALRUS_SPONSOR_MAX_BYTES=

# ── Seal (per-network) ────────────────────────────────────────────────────────
# Values here are the OFFICIAL decentralized committees (aggregator run by
# Mysten). Testnet is 3-of-5 and needs no credentials; mainnet is 5-of-8 and
# DOES. Leave the testnet pair empty to fall back to the same committee baked
# into seal-client.ts. To use independent servers instead, put a
# comma-separated list of their objectIds here and bump SEAL_THRESHOLD to match
# (their URLs are read from the on-chain KeyServer objects, not configured).
NEXT_PUBLIC_SEAL_KEY_SERVERS_TESTNET=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
NEXT_PUBLIC_SEAL_AGGREGATOR_URL_TESTNET=https://seal-aggregator-testnet.mystenlabs.com
NEXT_PUBLIC_SEAL_KEY_SERVERS_MAINNET=0x686098f1439237fff9f36b99c7329683c22979d2005c2465cb891acb012a7595
NEXT_PUBLIC_SEAL_AGGREGATOR_URL_MAINNET=https://seal-aggregator-mainnet.mystenlabs.com

# Retired key servers — DECRYPT ONLY, no aggregator, no API key.
# ⚠️ A Seal ciphertext records the key servers it was encrypted under, and
# decryption fetches shares from exactly those. So changing
# SEAL_KEY_SERVERS_* above bricks every ciphertext produced before the change
# ("Not enough shares. Please fetch more keys.") unless you list the old
# objectId here. Never remove an entry until the data it protects is
# re-encrypted or dead.
NEXT_PUBLIC_SEAL_LEGACY_KEY_SERVERS_TESTNET=
NEXT_PUBLIC_SEAL_LEGACY_KEY_SERVERS_MAINNET=

# Key-server auth. The SDK sends `<NAME>: <KEY>` as a raw HTTP header.
# MAINNET IS MANDATORY: the committee aggregator rejects unauthenticated calls.
# Get the key from the Enoki dashboard (sign up → request Seal key server
# access); the header name is ALWAYS `X-API-Key`. Testnet needs neither.
# Both fields must be set together (the SDK rejects a half-set pair).
# ⚠️ Like any NEXT_PUBLIC_*, this ships in the public JS bundle.
NEXT_PUBLIC_SEAL_API_KEY_NAME_TESTNET=
NEXT_PUBLIC_SEAL_API_KEY_TESTNET=
NEXT_PUBLIC_SEAL_API_KEY_NAME_MAINNET=X-API-Key
NEXT_PUBLIC_SEAL_API_KEY_MAINNET=

# ── Network-neutral ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SEAL_THRESHOLD=1
NEXT_PUBLIC_ENABLE_SEALED_SCHEMA=false

# ── Enoki / Google sign-in (network-neutral; Enoki supports testnet + mainnet) ─
NEXT_PUBLIC_ENOKI_PUBLIC_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional. When empty, falls back to `${window.location.origin}/` at runtime —
# convenient when the same build is deployed to multiple URLs (Walrus Sites,
# preview deploys, custom domains). Whatever origin you actually serve from
# MUST be whitelisted in Google Cloud Console's "Authorized redirect URIs".
NEXT_PUBLIC_ENOKI_REDIRECT_URL=

# ── Realtime collaboration (server-based, PartyKit — see docs/COLLAB_DESIGN.md) ──
# A shared draft syncs through a PartyKit Yjs document server (one room per
# formId) and persists there until publish. An UNSHARED draft never connects —
# it stays 100% local (IndexedDB), so collab is opt-in per form.
# Dev:  `npx partykit dev`         → 127.0.0.1:1999
# Prod: `npx partykit deploy`      → walform-collab.<account>.partykit.dev
NEXT_PUBLIC_ENABLE_COLLAB=true
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999
