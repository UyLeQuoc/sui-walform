{
  "site_name": "WalForm",
  "metadata": {
    "link": "https://walform.wal.app",
    "image_url": "https://walform.wal.app/images/og-image.png",
    "description": "Decentralized form builder on Walrus. End-to-end encrypted submissions, user-paid transactions, one-click per-form Walrus Sites — zero platform fee.",
    "project_url": "https://github.com/UyLeQuoc/sui-walform",
    "creator": "WalForm"
  },
  "headers": {
    "/assets/**": {
      "Cache-Control": "public, max-age=31536000, immutable"
    },
    "/images/**": {
      "Cache-Control": "public, max-age=604800"
    },
    "/*.html": {
      "Cache-Control": "public, max-age=300"
    }
  },
  "routes": {
    "/": "/index.html",
    "/forms": "/index.html",
    "/forms/": "/index.html",
    "/forms/edit": "/index.html",
    "/forms/edit/": "/index.html",
    "/forms/preview": "/index.html",
    "/forms/preview/": "/index.html",
    "/forms/results": "/index.html",
    "/forms/results/": "/index.html",
    "/f": "/index.html",
    "/f/": "/index.html",
    "/admin": "/index.html",
    "/admin/": "/index.html"
  }
}
