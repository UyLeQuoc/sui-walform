{
  "site_name": "WalForm",
  "metadata": {
    "link": "https://walform.wal.app",
    "image_url": "https://walform.wal.app/images/og-image.png",
    "description": "Decentralized form builder on Walrus. End-to-end encrypted submissions, sponsored gas, one-click per-form Walrus Sites — zero platform fee.",
    "project_url": "https://github.com/UyLeQuoc/sui-walform",
    "creator": "WalForm"
  },
  "headers": {
    "/_next/static/**": {
      "Cache-Control": "public, max-age=31536000, immutable"
    },
    "/_next/**": {
      "Cache-Control": "public, max-age=86400"
    },
    "/images/**": {
      "Cache-Control": "public, max-age=604800"
    },
    "/*.html": {
      "Cache-Control": "public, max-age=300"
    }
  },
  "routes": {
    "/": "/index.html",
    "/forms": "/forms/index.html",
    "/forms/": "/forms/index.html",
    "/forms/edit": "/forms/edit/index.html",
    "/forms/edit/": "/forms/edit/index.html",
    "/forms/preview": "/forms/preview/index.html",
    "/forms/preview/": "/forms/preview/index.html",
    "/forms/results": "/forms/results/index.html",
    "/forms/results/": "/forms/results/index.html",
    "/f": "/f/index.html",
    "/f/": "/f/index.html",
    "/admin": "/admin/index.html",
    "/admin/": "/admin/index.html"
  }
}
