# =============================================================================
# Portal (Walrus Sites gateway) — env for webpack dev/build.
# Copy to .env.local for local development; webpack.config.common.js reads it
# via `require('dotenv').config({ path: '.env.local' })`.
# =============================================================================

# Path to a portal-config.yaml whose values also feed DefinePlugin (env wins if set).
PORTAL_CONFIG=portal-config.yaml

# Subdomain segment count used by the Walrus Sites resolver (see upstream docs).
PORTAL_DOMAIN_NAME_LENGTH=

# Comma-separated list of pipe-delimited Sui fullnode RPC URLs.
#   format: {url}|{retries}|{metric},{url}|{retries}|{metric}
#   example: https://fullnode.testnet.sui.io:443|2|true
RPC_URL_LIST=

# Sui network for the SuiNS client. testnet | mainnet | devnet.
SUINS_CLIENT_NETWORK=testnet

# Comma-separated list of pipe-delimited Walrus aggregator URLs (same format as RPC_URL_LIST).
AGGREGATOR_URL_LIST=

# Original Walrus Sites package id on Sui (fallback: SITE_PACKAGE).
ORIGINAL_PACKAGE_ID=
SITE_PACKAGE=
