# =============================================================================
# Contracts deployer — copy to `.env.local` and fill the deployer wallet.
# =============================================================================

# -- Deployer wallet ----------------------------------------------------------
# For local dev, leave both blank and the publish script falls back to whatever
# address the Sui CLI has active (`sui client active-address`).
#
# For CI / scripted deploys: SUI_DEPLOYER_PRIVATE_KEY is a bech32-encoded
# Ed25519 private key (output of `sui keytool export --key-identity <alias>`).
# Something like: `suiprivkey1q...`.
SUI_DEPLOYER_PRIVATE_KEY=

# -- Network ------------------------------------------------------------------
SUI_NETWORK=testnet
# gRPC endpoint for publish/upgrade. Unset → `https://fullnode.<network>.sui.io`.
# (Replaces the old SUI_RPC_URL: Sui decommissioned public JSON-RPC — testnet's
# endpoint answers 404 already, mainnet's switches off 2026-07-31.)
SUI_GRPC_URL=

# -- Platform params ----------------------------------------------------------
# These are compiled into the Move package. Change before first publish only;
# after first publish, change by `bun run upgrade` + editing template.move.
PLATFORM_ROYALTY_BPS=1000            # 10%, PRD §7.2
PLATFORM_MIN_ROYALTY_MIST=50000000    # 0.05 SUI floor

# -- Post-publish state (mirrored from deployed.json) -------------------------
# Scripts write both this file and `deployed.json` on publish/upgrade.
# Do NOT edit these by hand — the scripts are the source of truth.
PACKAGE_ID=
ORIGINAL_PACKAGE_ID=                   # NEVER changes after first publish
UPGRADE_CAP_ID=
PUBLISHER_ID=
TRANSFER_POLICY_ID=
TRANSFER_POLICY_CAP_ID=
PLATFORM_TREASURY_ID=
PLATFORM_ADMIN_CAP_ID=
